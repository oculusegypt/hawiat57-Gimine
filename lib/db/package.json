{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "seed": "tsx ./src/seed.ts",
    "seed:homepage-content": "tsx ./src/seed-homepage-content.ts",
    "seed-demo": "tsx ./src/seed-demo.ts",
    "seed:container-system": "tsx ./src/seed-container-system.ts",
    "seed:rental-line-demo": "tsx ./src/seed-rental-line-demo.ts",
    "seed:driver-test": "tsx ./src/seed-driver-test.ts",
    "seed:assets-test": "tsx ./src/seed-assets-test.ts",
    "seed:roles": "tsx ./src/seed-role-demo.ts",
    "seed:posts": "tsx ./src/seed-posts.ts",
    "seed:posts2": "tsx ./src/seed-posts-2.ts",
    "test:financial-core": "rm -f /tmp/cleanflow-financial-core-test.db && DB_PATH=/tmp/cleanflow-financial-core-test.db pnpm run push && DB_PATH=/tmp/cleanflow-financial-core-test.db tsx ./src/financial-core.test.ts",
    "test:container-lifecycle": "rm -f /tmp/cleanflow-container-lifecycle-test.db && DB_PATH=/tmp/cleanflow-container-lifecycle-test.db pnpm run push && pnpm --filter @workspace/api-server run build && DB_PATH=/tmp/cleanflow-container-lifecycle-test.db SESSION_SECRET=cleanflow-container-lifecycle-test-secret tsx ../../artifacts/api-server/src/container-lifecycle.integration.test.ts",
    "test:financial-certification": "rm -f /tmp/cleanflow-financial-certification.db && DB_PATH=/tmp/cleanflow-financial-certification.db pnpm run push && DB_PATH=/tmp/cleanflow-financial-certification.db tsx ./src/financial-certification.test.ts",
    "test:financial-cross-report": "rm -f /tmp/cleanflow-financial-cross-report.db && DB_PATH=/tmp/cleanflow-financial-cross-report.db pnpm run push && DB_PATH=/tmp/cleanflow-financial-cross-report.db tsx ./src/financial-cross-report.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0"
  }
}
